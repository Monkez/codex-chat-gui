{
  "name": "@monkez/codex-chat-gui",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/lib/codex-chat-gui.umd.cjs",
  "module": "./dist/lib/codex-chat-gui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/codex-chat-gui.js",
      "require": "./dist/lib/codex-chat-gui.umd.cjs"
    },
    "./styles.css": "./dist/lib/codex-chat-gui.css"
  },
  "files": [
    "dist/lib",
    "dist/types",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "esbuild": "0.27.2"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:bridge": "node scripts/codex-bridge.mjs",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "test": "npm run build:lib && node --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "devDependencies": {
    "@openai/codex-sdk": "^0.137.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.7"
  }
}
